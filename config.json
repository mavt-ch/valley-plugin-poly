{
  "icon": "icon.svg",
  "main": "runtime/index.js",
  "runtime": {
    "ui": "runtime/index.js",
    "backend": "runtime/backend.js",
    "largeDataOperations": [
      "model.read",
      "campus.tile"
    ]
  },
  "assets": "runtime/assets",
  "uiSlots": {
    "left_sidebar": "poly.panel",
    "main_workspace": "poly.page"
  },
  "slotDefaults": {
    "left_sidebar": {
      "order": 220
    }
  },
  "keepTabIcon": true,
  "settingsSchema": {
    "fields": [
      {
        "key": "prices",
        "label": "Prices shown",
        "labelKey": "settings.prices.title",
        "type": "select",
        "default": "all",
        "description": "Which prices the menu cards show: all of them from students to guests, or one group's.",
        "descriptionKey": "settings.prices.description",
        "options": [
          {
            "value": "all",
            "label": "All prices",
            "labelKey": "prices.all"
          },
          {
            "value": "students",
            "label": "Students",
            "labelKey": "price.students"
          },
          {
            "value": "internal",
            "label": "Staff",
            "labelKey": "price.internal"
          },
          {
            "value": "external",
            "label": "Guests",
            "labelKey": "price.external"
          }
        ]
      },
      {
        "key": "onlyVegetarian",
        "label": "Only vegetarian",
        "labelKey": "settings.onlyVegetarian.title",
        "type": "boolean",
        "default": false,
        "description": "Show only vegetarian and vegan menus, in the place list counts and on the page.",
        "descriptionKey": "settings.onlyVegetarian.description"
      },
      {
        "key": "onlyVegan",
        "label": "Only vegan",
        "labelKey": "settings.onlyVegan.title",
        "type": "boolean",
        "default": false,
        "description": "Show only vegan menus.",
        "descriptionKey": "settings.onlyVegan.description"
      },
      {
        "key": "onlyGlutenFree",
        "label": "Only gluten-free",
        "labelKey": "settings.onlyGlutenFree.title",
        "type": "boolean",
        "default": false,
        "description": "Show only menus whose declared allergens contain no gluten cereal. A menu without declared allergens is not shown.",
        "descriptionKey": "settings.onlyGlutenFree.description"
      },
      {
        "key": "onlyLactoseFree",
        "label": "Only lactose-free",
        "labelKey": "settings.onlyLactoseFree.title",
        "type": "boolean",
        "default": false,
        "description": "Show only menus whose declared allergens contain no milk. A menu without declared allergens is not shown.",
        "descriptionKey": "settings.onlyLactoseFree.description"
      },
      {
        "key": "campus",
        "label": "Campus",
        "labelKey": "settings.campus.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "hoengg",
        "description": "The tag chosen in the menu plan: Favorites or a campus.",
        "descriptionKey": "settings.campus.description",
        "schema": {
          "type": "string",
          "enum": [
            "favorites",
            "eth",
            "hoengg",
            "uzh"
          ]
        }
      },
      {
        "key": "day",
        "label": "Day",
        "labelKey": "settings.day.title",
        "type": "custom",
        "settingsVisible": false,
        "default": {},
        "description": "The day and meal the menu plan shows; a past day falls back to today.",
        "descriptionKey": "settings.day.description",
        "schema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "maxLength": 10
            },
            "service": {
              "type": "string",
              "enum": [
                "lunch",
                "dinner"
              ]
            }
          }
        }
      },
      {
        "key": "favorites",
        "label": "Favorite places",
        "labelKey": "settings.favorites.title",
        "type": "custom",
        "settingsVisible": false,
        "default": [],
        "description": "The places starred in the menu plan.",
        "descriptionKey": "settings.favorites.description",
        "schema": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      {
        "key": "mode",
        "label": "Sidebar tab",
        "labelKey": "settings.mode.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "menu",
        "description": "The sidebar tab shown: the eLink shuttle, the menu plan, the campus map, ETH News or Polybox (2.0.0 saved the campus map's 3D predecessor as city, read as the campus map).",
        "descriptionKey": "settings.mode.description",
        "schema": {
          "type": "string",
          "enum": [
            "elink",
            "menu",
            "campus",
            "news",
            "polybox",
            "city"
          ]
        }
      },
      {
        "key": "tabOrder",
        "label": "Sidebar tab order",
        "labelKey": "settings.tabOrder.title",
        "type": "custom",
        "settingsVisible": false,
        "default": [
          "elink",
          "menu",
          "campus",
          "news",
          "polybox"
        ],
        "description": "The order of the sidebar's feature tabs, changed by dragging a tab or with Option and an arrow key.",
        "descriptionKey": "settings.tabOrder.description",
        "schema": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "elink",
              "menu",
              "campus",
              "news",
              "polybox"
            ]
          }
        }
      },
      {
        "key": "elinkDate",
        "label": "eLink day",
        "labelKey": "elink.settings.date.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "",
        "description": "The day the eLink tab shows; a past day falls back to today.",
        "descriptionKey": "elink.settings.date.description",
        "schema": {
          "type": "string",
          "maxLength": 10
        }
      },
      {
        "key": "newsFeed",
        "label": "News feed",
        "labelKey": "news.settings.feed.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "news",
        "description": "The ETH News feed the News tab shows: every article, the Zukunftsblog, Globe, the media releases or the Saved folder.",
        "descriptionKey": "news.settings.feed.description",
        "schema": {
          "type": "string",
          "enum": [
            "news",
            "zukunftsblog",
            "globe",
            "media",
            "saved"
          ]
        }
      },
      {
        "key": "newsTags",
        "label": "News tags",
        "labelKey": "news.settings.tags.title",
        "type": "custom",
        "settingsVisible": false,
        "default": [],
        "description": "The tags the News tab's article list is filtered by; an article with any of them is shown.",
        "descriptionKey": "news.settings.tags.description",
        "schema": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      {
        "key": "newsSaved",
        "label": "Saved articles",
        "labelKey": "news.settings.saved.title",
        "type": "custom",
        "settingsVisible": false,
        "default": [],
        "description": "The ETH News articles in the Saved folder, newest saved first, with what their rows need without the network.",
        "descriptionKey": "news.settings.saved.description",
        "schema": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 400
              },
              "title": {
                "type": "string",
                "maxLength": 400
              },
              "summary": {
                "type": "string",
                "maxLength": 2000
              },
              "published": {
                "type": "string",
                "maxLength": 40
              },
              "author": {
                "type": "string",
                "maxLength": 200
              },
              "topics": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "picture": {
                "type": "string",
                "maxLength": 600
              },
              "savedAt": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "url",
              "title",
              "summary",
              "published",
              "author",
              "topics",
              "picture",
              "savedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "key": "polyboxLinks",
        "label": "Polybox links",
        "labelKey": "polybox.settings.links.title",
        "type": "custom",
        "settingsVisible": false,
        "default": [],
        "description": "The subjects and their Polybox share links, added in the Polybox tab.",
        "descriptionKey": "polybox.settings.links.description",
        "schema": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      },
      {
        "key": "polyboxView",
        "label": "Polybox view",
        "labelKey": "polybox.settings.view.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "list",
        "description": "How a Polybox folder shows its entries: as a list or as a grid.",
        "descriptionKey": "polybox.settings.view.description",
        "schema": {
          "type": "string",
          "enum": [
            "list",
            "grid"
          ]
        }
      },
      {
        "key": "polyboxSort",
        "label": "Polybox sort",
        "labelKey": "polybox.settings.sort.title",
        "type": "custom",
        "settingsVisible": false,
        "default": {
          "key": "name",
          "dir": "asc"
        },
        "description": "Which column a Polybox folder is sorted by, ascending or descending; folders stay first.",
        "descriptionKey": "polybox.settings.sort.description",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "dir"
          ],
          "properties": {
            "key": {
              "type": "string",
              "enum": [
                "name",
                "created",
                "modified",
                "size"
              ]
            },
            "dir": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        }
      },
      {
        "key": "building",
        "label": "Building",
        "labelKey": "settings.building.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "",
        "description": "The ETH building selected on the campus map, by its code.",
        "descriptionKey": "settings.building.description",
        "schema": {
          "type": "string",
          "maxLength": 8
        }
      },
      {
        "key": "level",
        "label": "Floor",
        "labelKey": "settings.level.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "",
        "description": "The floor of the selected building whose rooms the campus map shows.",
        "descriptionKey": "settings.level.description",
        "schema": {
          "type": "string",
          "maxLength": 24
        }
      },
      {
        "key": "campusView",
        "label": "Campus view",
        "labelKey": "settings.campusView.title",
        "type": "custom",
        "settingsVisible": false,
        "default": "map",
        "description": "What the campus page shows: the 2D campus map or the 3D city model.",
        "descriptionKey": "settings.campusView.description",
        "schema": {
          "type": "string",
          "enum": [
            "map",
            "3d"
          ]
        }
      },
      {
        "key": "colorMode",
        "label": "Colour",
        "labelKey": "city.settings.colorMode",
        "type": "custom",
        "default": "surfaces",
        "settingsVisible": false,
        "schema": {
          "type": "string",
          "enum": [
            "surfaces",
            "height"
          ]
        }
      },
      {
        "key": "showGround",
        "label": "Ground",
        "labelKey": "city.settings.showGround",
        "type": "boolean",
        "default": true,
        "settingsVisible": false
      },
      {
        "key": "camera",
        "label": "Camera",
        "labelKey": "city.settings.camera",
        "type": "custom",
        "settingsVisible": false,
        "readOnly": true,
        "schema": {
          "type": "union",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "position": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "target": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "position",
                "target"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    ]
  },
  "permissions": {
    "network": {
      "hosts": [
        "idapps.ethz.ch",
        "app.food2050.ch",
        "storage.googleapis.com",
        "arcgis-prd-web.ethz.ch",
        "server.arcgisonline.com",
        "transport.opendata.ch",
        "ethz.ch",
        "polybox.ethz.ch"
      ]
    },
    "credentials": true,
    "storage": {
      "metadata": [
        "plugins/data/poly/model",
        "plugins/data/poly/polybox"
      ]
    },
    "largeData": true
  },
  "locales": {
    "en": "runtime/locales/en.json",
    "de": "runtime/locales/de.json",
    "es": "runtime/locales/es.json",
    "fr": "runtime/locales/fr.json",
    "zh-CN": "runtime/locales/zh-CN.json"
  },
  "provides": [
    {
      "id": "workspace.details",
      "kind": "extension",
      "version": "1.0.0"
    },
    {
      "id": "metadataPanel.segment",
      "kind": "extension",
      "version": "1.0.0"
    }
  ]
}
